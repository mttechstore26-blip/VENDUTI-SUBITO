[Unit]
Description=Optional Discord alerts from local sold listing snapshots

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/mttech-staging-alerts.env
ExecStart=/opt/mt-tech-venduti-dashboard/.venv/bin/python /opt/mt-tech-venduti-staging/integration/discord_opportunities.py
